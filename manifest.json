{
  "manifest_version": 3,
  "name": "Behavyour — Attention Guard",
  "version": "1.0.0",
  "description": "Understand and gently decondition unfocused browsing and pointer habits.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "optional_permissions": [
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Behavyour",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
